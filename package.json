{
  "name": "pool-management",
  "version": "1.0.0",
  "description": "Hệ thống quản lý hồ bơi (Pool Management System) - Fullstack Node.js + React.js + Prisma Migration (pnpm workspace)",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter pool-management-backend run dev",
    "dev:frontend": "pnpm --filter pool-management-frontend run dev",
    "build:frontend": "pnpm --filter pool-management-frontend run build",
    "db:migrate": "pnpm --filter pool-management-backend run db:migrate",
    "db:generate": "pnpm --filter pool-management-backend run db:generate",
    "db:studio": "pnpm --filter pool-management-backend run db:studio",
    "lint": "pnpm --filter \"*\" run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "pool-management",
    "nodejs",
    "react",
    "prisma",
    "postgresql",
    "pnpm"
  ],
  "author": "",
  "license": "ISC"
}
