PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=dev-pool-management-secret

# PostgreSQL for local/prod. Render/Supabase/Neon all provide this URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pool_management?schema=public"

# Free demo mode: keep uploaded face/check-in images in database text fields.
# For real production, use object storage instead.
STORE_UPLOADS_IN_DB=false
